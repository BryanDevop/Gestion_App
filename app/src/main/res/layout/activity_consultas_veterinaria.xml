<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarConsultas"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bluePrimary"
        app:title="Consultas"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_back_arrow"
        android:elevation="6dp" />

    <!-- Contenido -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:padding="20dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <!-- Diagnóstico -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_diagnostico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="6dp"
                app:cardCornerRadius="18dp"
                app:strokeColor="@color/blueLight"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp"
                    android:text="Diagnóstico"
                    android:textSize="20sp"
                    android:textColor="@color/bluePrimary"
                    android:textStyle="bold"
                    android:gravity="center"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tratamiento -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_tratamiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="6dp"
                app:cardCornerRadius="18dp"
                app:strokeColor="@color/greenPrimary"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp"
                    android:text="Tratamiento"
                    android:textSize="20sp"
                    android:textColor="@color/greenPrimary"
                    android:textStyle="bold"
                    android:gravity="center"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Medicamentos -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_medicamentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="6dp"
                app:cardCornerRadius="18dp"
                app:strokeColor="@color/blueLight"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp"
                    android:text="Medicamentos"
                    android:textSize="20sp"
                    android:textColor="@color/bluePrimary"
                    android:textStyle="bold"
                    android:gravity="center"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Observaciones -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_observaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="6dp"
                app:cardCornerRadius="18dp"
                app:strokeColor="@color/greenPrimary"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp"
                    android:text="Observaciones"
                    android:textSize="20sp"
                    android:textColor="@color/greenPrimary"
                    android:textStyle="bold"
                    android:gravity="center"/>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>