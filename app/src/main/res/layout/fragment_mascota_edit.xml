<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:title="Editar Mascota"
            app:titleTextColor="@color/white"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/white"
            app:menu="@menu/menu_edit_mascota" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Contenido del formulario -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card: Foto de la mascota -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center">

                    <!-- Foto circular -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgMascota"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_pet_placeholder"
                        app:shapeAppearanceOverlay="@style/CircleImage"
                        app:strokeWidth="3dp"
                        app:strokeColor="@color/primary" />

                    <!-- Botón cambiar foto -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCambiarFoto"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Cambiar foto"
                        android:textColor="@color/primary"
                        app:icon="@drawable/ic_camera"
                        app:iconTint="@color/primary"
                        app:iconGravity="start"
                        app:iconSize="20dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Información Básica -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Título -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐾 Información Básica"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginBottom="16dp" />

                    <!-- Nombre -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNombre"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Nombre de la mascota"
                        app:startIconDrawable="@drawable/ic_pet"
                        app:startIconTint="@color/primary"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/primary"
                        app:counterEnabled="true"
                        app:counterMaxLength="50">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNombre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="14dp"
                            android:inputType="textCapWords"
                            android:maxLength="50" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Tipo y Raza en fila -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginBottom="12dp">

                        <!-- Tipo -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilTipo"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:hint="Tipo"
                            app:startIconDrawable="@drawable/ic_pets"
                            app:startIconTint="@color/accent"
                            app:boxStrokeColor="@color/accent"
                            app:hintTextColor="@color/accent">

                            <AutoCompleteTextView
                                android:id="@+id/actvTipo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingVertical="14dp"
                                android:inputType="none" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Raza -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilRaza"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:hint="Raza"
                            app:boxStrokeColor="@color/accent"
                            app:hintTextColor="@color/accent">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etRaza"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingVertical="14dp"
                                android:inputType="textCapWords" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <!-- Sexo y Color en fila -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <!-- Sexo -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilSexo"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:hint="Sexo"
                            app:startIconDrawable="@drawable/ic_gender"
                            app:startIconTint="@color/info"
                            app:boxStrokeColor="@color/info"
                            app:hintTextColor="@color/info">

                            <AutoCompleteTextView
                                android:id="@+id/actvSexo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingVertical="14dp"
                                android:inputType="none" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Color -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilColor"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:hint="Color"
                            app:boxStrokeColor="@color/info"
                            app:hintTextColor="@color/info">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etColor"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingVertical="14dp"
                                android:inputType="textCapWords" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Datos Físicos -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Título -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚖️ Datos Físicos"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginBottom="16dp" />

                    <!-- Fecha de nacimiento y Peso en fila -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <!-- Fecha de nacimiento -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilFechaNacimiento"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:hint="Fecha de nacimiento"
                            app:startIconDrawable="@drawable/ic_calendar"
                            app:startIconTint="@color/success"
                            app:boxStrokeColor="@color/success"
                            app:hintTextColor="@color/success">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etFechaNacimiento"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingVertical="14dp"
                                android:focusable="false"
                                android:clickable="true"
                                android:inputType="none" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Peso -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPeso"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:hint="Peso"
                            app:startIconDrawable="@drawable/ic_weight"
                            app:startIconTint="@color/success"
                            app:boxStrokeColor="@color/success"
                            app:hintTextColor="@color/success"
                            app:suffixText=" kg">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPeso"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingVertical="14dp"
                                android:inputType="numberDecimal" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Información del Dueño -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Título -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👤 Información del Dueño"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginBottom="16dp" />

                    <!-- Nombre del dueño -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNombreDueno"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Nombre del dueño"
                        app:startIconDrawable="@drawable/ic_person"
                        app:startIconTint="@color/warning"
                        app:boxStrokeColor="@color/warning"
                        app:hintTextColor="@color/warning">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNombreDueno"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="14dp"
                            android:inputType="textCapWords" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Teléfono -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilTelefono"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Teléfono"
                        app:startIconDrawable="@drawable/ic_phone"
                        app:startIconTint="@color/warning"
                        app:boxStrokeColor="@color/warning"
                        app:hintTextColor="@color/warning">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTelefono"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="14dp"
                            android:inputType="phone" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Dirección -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDireccion"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Dirección (Opcional)"
                        app:startIconDrawable="@drawable/ic_location"
                        app:startIconTint="@color/warning"
                        app:boxStrokeColor="@color/warning"
                        app:hintTextColor="@color/warning"
                        app:counterEnabled="true"
                        app:counterMaxLength="150">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDireccion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="18dp"
                            android:paddingBottom="14dp"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="2"
                            android:maxLines="3"
                            android:gravity="top|start"
                            android:maxLength="150" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Notas adicionales -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Título -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📝 Notas Adicionales"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginBottom="16dp" />

                    <!-- Notas -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNotas"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Observaciones (Opcional)"
                        app:startIconDrawable="@drawable/ic_note"
                        app:startIconTint="@color/gray_medium"
                        app:boxStrokeColor="@color/gray_medium"
                        app:hintTextColor="@color/gray_medium"
                        app:counterEnabled="true"
                        app:counterMaxLength="200">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNotas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="18dp"
                            android:paddingBottom="14dp"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="3"
                            android:maxLines="5"
                            android:gravity="top|start"
                            android:maxLength="200" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Botones de acción -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="80dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelar"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Cancelar"
                    android:textSize="15sp"
                    app:strokeColor="@color/gray_medium"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardar"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Guardar Cambios"
                    android:textSize="15sp"
                    app:backgroundTint="@color/primary"
                    app:icon="@drawable/ic_save"
                    app:iconGravity="textStart"
                    app:iconSize="20dp"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- FAB: Eliminar mascota -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabEliminar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="Eliminar"
        android:textColor="@color/white"
        app:icon="@drawable/ic_delete"
        app:iconTint="@color/white"
        app:backgroundTint="@color/error"
        app:elevation="6dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>