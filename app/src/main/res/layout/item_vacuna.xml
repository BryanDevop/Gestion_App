<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Icono de vacuna -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIcono"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:cardCornerRadius="25dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#E8F5E9"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_vaccine"
                app:tint="@color/success" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Info de la vacuna -->
        <TextView
            android:id="@+id/tvNombreVacuna"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Rabia"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintTop_toTopOf="@id/cardIcono"
            app:layout_constraintStart_toEndOf="@id/cardIcono"
            app:layout_constraintEnd_toStartOf="@id/btnMenu" />

        <!-- Mascota -->
        <LinearLayout
            android:id="@+id/layoutMascota"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/tvNombreVacuna"
            app:layout_constraintStart_toEndOf="@id/cardIcono">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_pet"
                app:tint="@color/gray_medium" />

            <TextView
                android:id="@+id/tvMascota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Firulais"
                android:textSize="13sp"
                android:textColor="@color/gray_dark"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <!-- Separador -->
        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/gray_light"
            app:layout_constraintTop_toBottomOf="@id/cardIcono"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Información de fechas -->
        <LinearLayout
            android:id="@+id/layoutFechas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Fecha aplicación -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aplicación"
                    android:textSize="10sp"
                    android:textColor="@color/gray_medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFechaAplicacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15 Ene 2024"
                    android:textSize="13sp"
                    android:textColor="@color/black"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Fecha próxima dosis -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Próxima dosis"
                    android:textSize="10sp"
                    android:textColor="@color/gray_medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProximaDosis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15 Ene 2025"
                    android:textSize="13sp"
                    android:textColor="@color/warning"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Veterinario y lote -->
        <LinearLayout
            android:id="@+id/layoutInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/layoutFechas"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Veterinario -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_doctor"
                    app:tint="@color/gray_medium" />

                <TextView
                    android:id="@+id/tvVeterinario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dr. Pérez"
                    android:textSize="11sp"
                    android:textColor="@color/gray_medium"
                    android:layout_marginStart="4dp"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Lote -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_tag"
                    app:tint="@color/gray_medium" />

                <TextView
                    android:id="@+id/tvLote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lote: ABC123"
                    android:textSize="11sp"
                    android:textColor="@color/gray_medium"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Badge de estado -->
        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIGENTE"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/success"
            android:background="@drawable/bg_badge_success"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnMenu" />

        <!-- Botón menú -->
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_more_vert"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/gray_medium"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>