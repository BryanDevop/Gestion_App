<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFB">

    <!-- App Bar con flecha de retroceso -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:elevation="4dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#FFFFFF"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:titleTextColor="#0D47A1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Plan de Tratamiento"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#0D47A1"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paso 2 de 2"
                    android:textSize="12sp"
                    android:textColor="#42A5F5"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Contenido principal -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Banner informativo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info_banner_blue"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_treatment"
                    android:tint="#2196F3"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Define el plan de tratamiento para la recuperación del paciente"
                    android:textSize="14sp"
                    android:textColor="#37474F"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>

            <!-- Card: Tipo de Tratamiento -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#E3F2FD"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_medical"
                            android:tint="#2196F3"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tipo de Tratamiento"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#0D47A1"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Selecciona uno o más tipos de tratamiento"
                        android:textSize="13sp"
                        android:textColor="#78909C"
                        android:layout_marginBottom="16dp"/>

                    <!-- Medicación -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#BBDEFB"
                        app:strokeWidth="1dp"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="4dp">

                            <CheckBox
                                android:id="@+id/cbMedicacion"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="💊 Medicación"
                                android:textSize="15sp"
                                android:textColor="#1565C0"
                                android:buttonTint="#2196F3"
                                android:padding="8dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Cirugía -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#C8E6C9"
                        app:strokeWidth="1dp"
                        android:layout_marginBottom="10dp">

                        <CheckBox
                            android:id="@+id/cbCirugia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🏥 Cirugía"
                            android:textSize="15sp"
                            android:textColor="#2E7D32"
                            android:buttonTint="#4CAF50"
                            android:padding="12dp"/>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Terapia física -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#BBDEFB"
                        app:strokeWidth="1dp"
                        android:layout_marginBottom="10dp">

                        <CheckBox
                            android:id="@+id/cbTerapia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🤸 Terapia física"
                            android:textSize="15sp"
                            android:textColor="#1565C0"
                            android:buttonTint="#2196F3"
                            android:padding="12dp"/>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Dieta especial -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#C8E6C9"
                        app:strokeWidth="1dp"
                        android:layout_marginBottom="10dp">

                        <CheckBox
                            android:id="@+id/cbDieta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🥗 Dieta especial"
                            android:textSize="15sp"
                            android:textColor="#2E7D32"
                            android:buttonTint="#4CAF50"
                            android:padding="12dp"/>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Reposo -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#BBDEFB"
                        app:strokeWidth="1dp">

                        <CheckBox
                            android:id="@+id/cbReposo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🛌 Reposo"
                            android:textSize="15sp"
                            android:textColor="#1565C0"
                            android:buttonTint="#2196F3"
                            android:padding="12dp"/>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Descripción del Tratamiento -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#E8F5E9"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_description"
                            android:tint="#4CAF50"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Descripción del Tratamiento"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#1B5E20"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Detalla el procedimiento y recomendaciones"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxStrokeColor="#4CAF50"
                        app:hintTextColor="#4CAF50"
                        app:counterEnabled="true"
                        app:counterMaxLength="1000">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDescripcionTratamiento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="5"
                            android:maxLines="8"
                            android:gravity="top"
                            android:textColor="#263238"
                            android:textSize="16sp"
                            android:maxLength="1000"/>
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Duración -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#E3F2FD"
                app:strokeWidth="1dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_calendar"
                            android:tint="#2196F3"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Duración del Tratamiento"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#0D47A1"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="Cantidad"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxStrokeColor="#2196F3"
                            app:hintTextColor="#2196F3"
                            app:startIconDrawable="@drawable/ic_number"
                            app:startIconTint="#42A5F5"
                            android:layout_marginEnd="12dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDuracionCantidad"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:textColor="#263238"
                                android:textSize="16sp"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="Unidad"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            app:boxStrokeColor="#2196F3"
                            app:hintTextColor="#2196F3">

                            <AutoCompleteTextView
                                android:id="@+id/spinnerDuracionUnidad"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:textColor="#263238"
                                android:textSize="16sp"/>
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Fecha de inicio"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxStrokeColor="#2196F3"
                        app:hintTextColor="#2196F3"
                        app:startIconDrawable="@drawable/ic_calendar"
                        app:startIconTint="#42A5F5"
                        app:endIconMode="custom"
                        app:endIconDrawable="@drawable/ic_calendar_today"
                        app:endIconTint="#42A5F5">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFechaInicio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:focusable="false"
                            android:clickable="true"
                            android:textColor="#263238"
                            android:textSize="16sp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Botones de navegación -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAnterior"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="56dp"
                    android:text="Anterior"
                    android:textSize="16sp"
                    android:textColor="#546E7A"
                    android:textStyle="bold"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="#78909C"
                    app:strokeWidth="2dp"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/ic_arrow_back"
                    app:iconGravity="start"
                    app:iconTint="#78909C"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSiguiente"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="56dp"
                    android:text="Finalizar"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#4CAF50"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="end"
                    app:iconTint="#FFFFFF"
                    android:layout_marginStart="8dp"
                    app:elevation="4dp"/>
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>